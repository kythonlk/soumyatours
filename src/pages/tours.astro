---
import Layout from '../layouts/Layout.astro';
import TourCard from '../components/TourCard.astro';
import { getTours } from '../lib/api';

const tours = await getTours();
---

<Layout title="Tour Packages & Pilgrimages | Saumya Tours Sri Lanka">
  <div class="bg-[#022c22] text-white py-12 border-b border-emerald-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-[0.25em] text-amber-300 font-mono">// EXPLORE DESTINATIONS</span>
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mt-1 text-white">All Tours & Sacred Pilgrimages</h1>
      <p class="text-xs sm:text-sm text-emerald-100/80 mt-2 max-w-xl font-light">
        Choose from our signature 12-day India Dambadiva circuit, 7-day Sri Lanka island highlights, or customized wildlife safaris.
      </p>

      <!-- Category Filter Tabs -->
      <div class="mt-8 flex flex-wrap gap-2 text-xs font-semibold">
        <button onclick="filterSaumya('all')" class="saumya-filter-btn active px-4 py-2 bg-amber-500 text-slate-950 rounded-lg shadow-sm transition-colors">
          All Packages ({tours.length})
        </button>
        <button onclick="filterSaumya('dambadiva-pilgrimages')" class="saumya-filter-btn px-4 py-2 bg-emerald-900/80 text-emerald-100 hover:text-white rounded-lg border border-emerald-700/60 transition-colors">
          ☸️ India Dambadiva Pilgrimages
        </button>
        <button onclick="filterSaumya('sri-lanka-tours')" class="saumya-filter-btn px-4 py-2 bg-emerald-900/80 text-emerald-100 hover:text-white rounded-lg border border-emerald-700/60 transition-colors">
          🇱🇰 Sri Lanka Inbound Tours
        </button>
        <button onclick="filterSaumya('day-excursions')" class="saumya-filter-btn px-4 py-2 bg-emerald-900/80 text-emerald-100 hover:text-white rounded-lg border border-emerald-700/60 transition-colors">
          Day Excursions & Safaris
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Grid -->
    <div id="saumya-tours-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {tours.map(tour => (
        <div class="tour-item-wrapper" data-category={tour.category_slug}>
          <TourCard tour={tour} />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="saumya-empty-msg" class="hidden py-20 text-center text-slate-500">
      <p class="font-heading text-lg">No tour packages found under this category.</p>
      <button onclick="filterSaumya('all')" class="mt-3 text-xs text-emerald-800 font-bold hover:underline">
        View All Packages
      </button>
    </div>
  </div>

  <script is:inline>
    function filterSaumya(categorySlug) {
      const items = document.querySelectorAll('.tour-item-wrapper');
      const buttons = document.querySelectorAll('.saumya-filter-btn');
      let visible = 0;

      buttons.forEach(btn => {
        btn.classList.remove('bg-amber-500', 'text-slate-950');
        btn.classList.add('bg-emerald-900/80', 'text-emerald-100');
        if (btn.getAttribute('onclick')?.includes(categorySlug)) {
          btn.classList.add('bg-amber-500', 'text-slate-950');
          btn.classList.remove('bg-emerald-900/80', 'text-emerald-100');
        }
      });

      items.forEach(item => {
        const cat = item.getAttribute('data-category');
        if (categorySlug === 'all' || cat === categorySlug) {
          item.classList.remove('hidden');
          visible++;
        } else {
          item.classList.add('hidden');
        }
      });

      const empty = document.getElementById('saumya-empty-msg');
      if (empty) {
        if (visible === 0) empty.classList.remove('hidden');
        else empty.classList.add('hidden');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const cat = params.get('category');
      if (cat) filterSaumya(cat);
    });
  </script>
</Layout>
