---
import Layout from '../layouts/Layout.astro';
import HirePlanner from '../components/HirePlanner.astro';
import FleetCards from '../components/FleetCards.astro';

const faqs = [
  {
    q: 'How is the hire price calculated?',
    a: 'Request a written quote for your vehicle, route, dates, duration, and stops. Ask whether fuel, driver arrangements, waiting time, parking, and tolls are included before confirming.',
  },
  {
    q: 'Can I book a guide as well?',
    a: 'Yes, you can request guide arrangements with your hire. Tell us the places you want to visit and your preferred language. The team will confirm availability and any additional cost.',
  },
  {
    q: 'How many travelers can each vehicle take?',
    a: 'Please send your group size and luggage details. Our team will confirm the actual seating configuration and space before accepting your request.',
  },
  {
    q: 'Is my WhatsApp request a confirmed booking?',
    a: 'No. The request starts a conversation. Your vehicle, price, schedule, and terms must be confirmed directly with our team.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Local Vehicle Hire in Pita Kotte & Colombo',
  serviceType: 'Private vehicle hire and airport transfers',
  areaServed: [
    { '@type': 'City', name: 'Pita Kotte' },
    { '@type': 'City', name: 'Colombo' },
    { '@type': 'Country', name: 'Sri Lanka' },
  ],
  provider: { '@type': 'TravelAgency', name: 'Saumya Tours' },
};
---
<Layout
  title="Local Vehicle Hire in Pita Kotte & Colombo | Saumya Tours"
  description="Request local vehicle hire from Pita Kotte for Colombo transfers, airport trips, day outings, and weddings. Choose a Nissan Caravan or Mercedes-Benz AMG C-Class."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Local hires', href: '/local-hires' }]}
  schema={[serviceSchema, faqSchema]}
>
  <section class="page-hero">
    <div class="container">
      <p class="breadcrumb"><a href="/">Home</a> / Local hires</p>
      <h1>Local vehicle hires from Pita Kotte.</h1>
      <p>
        Airport transfers, Colombo appointments, family outings, and special occasions. Choose between our Nissan Caravan and Mercedes-Benz AMG C-Class and request a written route quote.
      </p>
      <div class="hero-actions">
        <a href="#hire-planner" class="button button-primary">Plan a local hire</a>
        <a href="/fleet" class="text-link">Meet the fleet</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <HirePlanner />
    </div>
  </section>

  <section class="section section-stone">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>A ride for your kind of day.</h2>
          <p>Our fleet includes one Nissan Caravan and one Mercedes-Benz AMG C-Class. Availability is confirmed for each request.</p>
        </div>
      </div>
      <FleetCards />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-intro">
        <h2>From everyday transfers to special occasions.</h2>
      </div>
      <div class="values-grid">
        <div class="value">
          <h3>Airport transfers</h3>
          <p>Share your flight number, pickup address, group size, and luggage details. Ask about a one-way or return transfer to Bandaranaike International Airport.</p>
          <a href="/news/bandaranaike-airport-transfer-guide" class="text-link">Airport transfer guide</a>
        </div>
        <div class="value">
          <h3>Day trips &amp; local travel</h3>
          <p>Plan a family outing, appointments, business visits, or a day with several stops around Colombo and Sri Lanka. Send your route for a tailored quote.</p>
          <a href="/news/planning-a-local-vehicle-hire" class="text-link">5 details for a smooth quote</a>
        </div>
        <div class="value">
          <h3>Weddings &amp; occasions</h3>
          <p>Ask about the Mercedes-Benz AMG C-Class for your event. Tell us the date, timings, pickup, and waiting requirements.</p>
          <a href="/news/choosing-car-or-van-hire" class="text-link">Car or van comparison</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-stone">
    <div class="container faq">
      <div class="section-intro">
        <h2>Hire questions, answered.</h2>
      </div>
      {faqs.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
