---
import Layout from '../layouts/Layout.astro';
import TourCard from '../components/TourCard.astro';
import { getCatalog } from '../lib/catalog';
const tours = (await getCatalog()).filter(t => t.category_slug === 'dambadiva-pilgrimages');
const places = [{name:'Lumbini',place:'Nepal',text:'Visit the birthplace of Siddhartha Gautama and the Maya Devi Temple.'},{name:'Bodh Gaya',place:'India',text:'Spend time at the Mahabodhi Temple and the sacred Bodhi Tree.'},{name:'Sarnath',place:'India',text:'Reflect at the site associated with the Buddha’s first teaching.'},{name:'Kushinagar',place:'India',text:'Pay respects at the Parinirvana Temple and surrounding sacred sites.'}];
---
<Layout title="Dambadiva pilgrimages to India & Nepal | Saumya Tours" description="Explore Buddhist pilgrimage itineraries from Sri Lanka to Bodh Gaya, Sarnath, Kushinagar, and Lumbini. Plan your Dambadiva journey with Saumya Tours.">
  <section class="image-hero"><img src="/images/dambadiva.webp" alt="Mahabodhi Temple and Buddhist pilgrimage landmarks" width="1400" height="900" fetchpriority="high" /><div class="container"><p class="breadcrumb"><a href="/">Home</a> / Dambadiva</p><h1>Make space for<br />a sacred journey.</h1><p>Follow the Buddhist circuit through India and Nepal. A pilgrimage for reflection, devotion, and the people you share it with.</p><div class="hero-actions"><a href="#pilgrimages" class="button button-light">Explore the pilgrimages</a></div></div></section>
  <section class="section"><div class="container"><div class="section-intro"><h2>Four places.<br />A lifetime of meaning.</h2><p>The sacred Buddhist circuit connects the Buddha’s birthplace, enlightenment, first teaching, and passing into Parinirvana.</p></div><div class="sacred-sites">{places.map(place => <div class="value"><p class="place-country">{place.place}</p><h3>{place.name}</h3><p>{place.text}</p></div>)}</div></div></section>
  <section class="section section-soft" id="pilgrimages"><div class="container"><div class="section-head"><div><h2>Find your pilgrimage.</h2><p>Compare the routes, then ask our team about departure dates and arrangements for your group.</p></div></div><div class="tour-grid">{tours.map(tour => <TourCard tour={tour} />)}</div>{!tours.length && <div class="empty-state"><p>Contact our team for current pilgrimage options.</p><button class="button button-primary" data-inquire="Dambadiva pilgrimage">Ask about a pilgrimage</button></div>}</div></section>
  <section class="section"><div class="container"><div class="section-intro"><h2>Plan with peace of mind.</h2><p>Every traveler has different needs. Please discuss yours with us before confirming a booking.</p></div><div class="values-grid"><div class="value"><h3>Guidance & worship</h3><p>Ask about the tour leader, languages spoken, temple visits, and time for worship on your chosen departure.</p></div><div class="value"><h3>Comfort & care</h3><p>Let us know about mobility, dietary, or medical requirements so we can discuss suitable arrangements.</p></div><div class="value"><h3>Travel documents</h3><p>Confirm the passport, visa, and entry requirements for each country on your route before making travel commitments.</p></div></div></div></section>
</Layout>
