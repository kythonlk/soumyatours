---
import Layout from '../../layouts/Layout.astro';
import { getTours, type TourPackage } from '../../lib/api';

export async function getStaticPaths() {
  const tours = await getTours();
  return tours.map(tour => ({
    params: { slug: tour.slug },
    props: { tour }
  }));
}

interface Props {
  tour: TourPackage;
}

const { tour } = Astro.props;
const primaryImage = tour.images?.[0]?.url || '/images/dambadiva.jpg';
const discount = tour.compare_at_price && tour.compare_at_price > tour.price
  ? tour.compare_at_price - tour.price
  : 0;
---

<Layout title={`${tour.title} | Saumya Tours`} description={tour.short_description}>
  <!-- Hero Banner for Tour -->
  <div class="relative bg-[#022c22] text-white min-h-[420px] flex items-end pb-12 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src={primaryImage} alt={tour.title} class="w-full h-full object-cover object-center filter brightness-75" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#022c22] via-[#022c22]/40 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="flex items-center gap-3 text-xs font-semibold mb-3">
        <span class="bg-amber-400 text-slate-950 px-3 py-1 rounded-full uppercase tracking-wider">
          {tour.country === 'India (Dambadiva)' ? '☸️ Sacred Dambadiva Pilgrimage' : '🇱🇰 Sri Lanka Tour'}
        </span>
        <span class="bg-black/50 backdrop-blur-xs text-white px-3 py-1 rounded-full">
          ⏱ {tour.duration_days} Days / {tour.duration_days - 1} Nights
        </span>
      </div>

      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white max-w-3xl leading-tight">
        {tour.title}
      </h1>

      <div class="flex items-center gap-3 mt-3 text-xs text-emerald-200">
        <span class="text-amber-400">★★★★★</span>
        <span>{tour.avg_rating || 5.0} Rating</span>
        <span>•</span>
        <span>{tour.review_count || 50} Sri Lankan Pilgrims & Travelers Reviewed</span>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Main Content Column -->
      <div class="lg:col-span-8 space-y-10">
        <!-- Overview -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-emerald-100 shadow-sm space-y-4">
          <h2 class="font-heading text-xl font-bold text-slate-900 border-b pb-3">Trip Overview</h2>
          <div class="prose text-xs sm:text-sm text-slate-600 leading-relaxed font-light" set:html={tour.description} />
        </div>

        <!-- Day-by-Day Itinerary Accordion -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="font-heading text-xl font-bold text-slate-900">Day-by-Day Journey Itinerary</h2>
            <span class="text-xs text-emerald-800 font-semibold">{tour.itinerary?.length || 0} Journey Stages</span>
          </div>

          <div class="space-y-3">
            {tour.itinerary?.map((stage, idx) => (
              <details class="group bg-white rounded-xl border border-emerald-100 p-5 shadow-xs transition-all open:border-emerald-500/60 open:shadow-md" open={idx === 0}>
                <summary class="flex items-center justify-between cursor-pointer list-none">
                  <div class="flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-emerald-800 text-amber-200 font-bold text-xs flex items-center justify-center font-mono">
                      D{stage.day}
                    </span>
                    <h3 class="font-heading text-sm font-bold text-slate-900 group-hover:text-emerald-800 transition-colors">
                      {stage.title}
                    </h3>
                  </div>
                  <span class="text-emerald-800 font-bold text-base group-open:rotate-180 transition-transform">
                    ↓
                  </span>
                </summary>

                <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-600 leading-relaxed space-y-2">
                  <p>{stage.description}</p>
                  {stage.highlights && stage.highlights.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 pt-2">
                      {stage.highlights.map(h => (
                        <span class="text-[10px] font-semibold bg-emerald-50 text-emerald-800 px-2.5 py-0.5 rounded-full border border-emerald-200">
                          📍 {h}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>

        <!-- Inclusions and Exclusions Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-emerald-50/70 p-6 rounded-2xl border border-emerald-200 space-y-3">
            <h3 class="font-heading text-base font-bold text-emerald-950 flex items-center gap-2">
              <span class="text-emerald-700">✓</span> What is Included
            </h3>
            <ul class="space-y-2 text-xs text-slate-700">
              {tour.inclusions?.map(inc => (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-600 font-bold">•</span>
                  <span>{inc}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 space-y-3">
            <h3 class="font-heading text-base font-bold text-slate-800 flex items-center gap-2">
              <span class="text-slate-400">✕</span> What is Not Included
            </h3>
            <ul class="space-y-2 text-xs text-slate-600">
              {tour.exclusions?.map(exc => (
                <li class="flex items-start gap-2">
                  <span class="text-slate-400 font-bold">•</span>
                  <span>{exc}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Booking Card Sidebar Column -->
      <div class="lg:col-span-4">
        <div class="bg-white p-6 rounded-2xl border border-emerald-200 shadow-xl sticky top-28 space-y-6">
          <div>
            <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold">All-Inclusive Tour Package</span>
            <div class="flex items-baseline gap-3 mt-1">
              <span class="font-heading text-3xl font-bold text-emerald-950">
                Rs. {tour.price.toLocaleString()}
              </span>
              {tour.compare_at_price && (
                <span class="text-sm text-slate-400 line-through">
                  Rs. {tour.compare_at_price.toLocaleString()}
                </span>
              )}
            </div>
            <div class="text-xs text-emerald-800 font-medium mt-1">Per Person (Twin Sharing / Full Board)</div>
          </div>

          <div class="space-y-2 text-xs text-slate-600 border-t border-b border-slate-100 py-3">
            <div class="flex justify-between">
              <span>Duration:</span>
              <span class="font-semibold text-slate-900">{tour.duration_days} Days / {tour.duration_days - 1} Nights</span>
            </div>
            <div class="flex justify-between">
              <span>Seats Available:</span>
              <span class="font-semibold text-emerald-700">{tour.total_stock} spots remaining</span>
            </div>
            <div class="flex justify-between">
              <span>Departure:</span>
              <span class="font-semibold text-slate-900">Colombo CMB Airport</span>
            </div>
          </div>

          <div class="space-y-3">
            <button 
              onclick={`window.openBookingModal('${tour.title.replace(/'/g, "\\'")}')`}
              class="w-full py-3.5 bg-emerald-800 hover:bg-emerald-700 text-amber-200 font-bold text-xs uppercase tracking-wider rounded-xl shadow-lg transition-colors flex items-center justify-center gap-2"
            >
              Reserve / Inquire Package
            </button>
            <a 
              href={`https://wa.me/94775678901?text=Hello%20Saumya%20Tours,%20I%20am%20interested%20in%20booking:%20${encodeURIComponent(tour.title)}`}
              target="_blank"
              rel="noopener"
              class="w-full py-3 bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs uppercase tracking-wider rounded-xl transition-colors flex items-center justify-center gap-2 shadow-xs"
            >
              WhatsApp Direct Booking
            </a>
          </div>

          <div class="p-4 bg-amber-50 rounded-xl border border-amber-200 text-xs text-amber-900 space-y-1">
            <div class="font-bold">SLTDA Tourist Guarantee:</div>
            <p class="text-[11px] leading-relaxed">
              Official Sri Lanka Tourism accredited operator. Senior citizens given priority wheelchair assistance and room placement across all hotels.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
