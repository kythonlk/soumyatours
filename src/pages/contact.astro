---
import Layout from '../layouts/Layout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site, whatsappLink } from '../lib/site';
---
<Layout title="Let’s plan your trip | Contact Saumya Tours" description="Contact Saumya Tours in Pita Kotte, Sri Lanka. Ask about island holidays, Dambadiva pilgrimages, travel dates, and custom itineraries.">
  <section class="page-hero"><div class="container"><p class="breadcrumb"><a href="/">Home</a> / Contact</p><h1>Your next journey<br />starts here.</h1><p>A destination in mind? Or just the feeling that it’s time to go? Tell us a little about your plans.</p></div></section>
  <section class="section"><div class="container contact-grid"><div class="contact-copy"><h2>Talk to a real person.</h2><p>Ask about a route, check availability, or tell us what you need to travel comfortably.</p><div class="contact-detail"><h3>Visit us in Pita Kotte</h3><p>{site.address}</p><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`} target="_blank" rel="noopener noreferrer">Find us on the map ↗</a><p class="form-note">Please contact us to arrange your visit.</p></div><div class="contact-detail"><h3>WhatsApp</h3><a href={whatsappLink('Hello Saumya Tours, I would like to plan a journey.')} target="_blank" rel="noopener noreferrer">{site.phone}</a></div><div class="contact-detail"><h3>Email</h3><a href={`mailto:${site.email}`}>{site.email}</a></div><div class="contact-detail"><h3>Before you book</h3><p>Ask for current dates, pricing, inclusions, visa requirements, and cancellation terms in writing.</p></div></div><div class="form-panel"><h2>Tell us about your trip.</h2><p>We’ll prepare your message for WhatsApp. Fields marked * are required.</p><InquiryForm id="contact" /></div></div></section>
</Layout>
