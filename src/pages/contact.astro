---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact & Pilgrimage Booking | Saumya Tours Sri Lanka">
  <div class="bg-[#022c22] text-white py-12 border-b border-emerald-900 text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-[0.25em] text-amber-300 font-mono">// GET IN TOUCH</span>
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mt-2 text-white">Contact & Tour Inquiries</h1>
      <p class="text-xs sm:text-sm text-emerald-100 mt-2 max-w-xl mx-auto font-light">
        Visit our Colombo office for pilgrimage documentation or message our tour coordinators directly on WhatsApp.
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid grid-cols-1 md:grid-cols-2 gap-12">
    <!-- Contact Info -->
    <div class="space-y-6 text-xs text-slate-600">
      <div class="space-y-1">
        <h3 class="font-heading text-lg font-bold text-emerald-950">Colombo Head Office</h3>
        <p class="text-sm text-slate-800">No. 72, Cotta Road, Borella, Colombo 08, Sri Lanka</p>
        <p class="text-slate-500">Mon – Sat: 8:30 AM – 6:00 PM | Sun: 9:00 AM – 2:00 PM</p>
      </div>

      <div class="space-y-1">
        <h3 class="font-heading text-base font-bold text-emerald-950">India Pilgrimage Liaison Office</h3>
        <p>Main Temple Road (Near Sri Lanka Maha Bodhi Guest House), Bodh Gaya, Bihar 824231, India</p>
        <p class="text-emerald-800 font-semibold">Coordination Officer: +91 94312 34567</p>
      </div>

      <div class="space-y-2 pt-2 border-t border-slate-200">
        <h4 class="font-heading text-sm font-bold text-slate-900">Direct Contacts</h4>
        <p>Office Landline: +94 11 267 8900 / +94 11 267 8901</p>
        <p class="text-emerald-800 font-bold text-sm">WhatsApp Priority Line: +94 77 567 8901</p>
        <p>Email: reservations@saumyatours.lk / info@saumyatours.lk</p>
      </div>

      <div class="p-4 bg-emerald-50 rounded-xl border border-emerald-200 text-emerald-900 space-y-1">
        <div class="font-bold">Pilgrimage Visa Processing:</div>
        <p class="text-[11px]">
          We manage all Indian tourist/pilgrim e-visas and documents directly at our Colombo office. Bring your original passport (valid 6+ months) and 2 passport photos.
        </p>
      </div>
    </div>

    <!-- Booking Form -->
    <div class="bg-white p-8 rounded-2xl border border-emerald-200 shadow-xl space-y-4">
      <h3 class="font-heading text-base font-bold text-emerald-950">Inquire or Request Callback</h3>
      <form id="saumya-contact-form" class="space-y-3 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Your Full Name</label>
          <input type="text" required class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:border-emerald-600 focus:outline-hidden" placeholder="e.g. Asoka Perera" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Mobile / WhatsApp Number</label>
          <input type="tel" required class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:border-emerald-600 focus:outline-hidden" placeholder="+94 77 ..." />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Tour of Interest</label>
          <select class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:border-emerald-600 focus:outline-hidden bg-white">
            <option>12-Day Sacred India Dambadiva Pilgrimage</option>
            <option>10-Day India Dambadiva Classic Tour</option>
            <option>7-Day Wonders of Sri Lanka (Cultural Triangle & Hill Country)</option>
            <option>Yala Safari & Southern Coast Tour</option>
            <option>Custom Private Sri Lanka Chauffeur Tour</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Message or Questions</label>
          <textarea rows="3" required class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:border-emerald-600 focus:outline-hidden" placeholder="Number of devotees, preferred month of travel..."></textarea>
        </div>
        <button type="submit" class="w-full py-3 bg-emerald-800 hover:bg-emerald-700 text-amber-200 font-bold uppercase tracking-wider rounded-lg transition-colors shadow-md text-xs">
          Send Message
        </button>
        <div id="saumya-contact-success" class="hidden text-emerald-800 text-center font-bold pt-2">
          ✓ Thank you! Our pilgrimage coordinator will contact you via WhatsApp/call within 2 hours.
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    document.getElementById('saumya-contact-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      document.getElementById('saumya-contact-success')?.classList.remove('hidden');
      e.target.reset();
    });
  </script>
</Layout>
