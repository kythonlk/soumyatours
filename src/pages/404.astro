---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Saumya Tours" noindex>
  <section class="section">
    <div class="container prose-page">
      <p class="breadcrumb"><a href="/">Home</a> / Page not found</p>
      <h1>This page could not be found.</h1>
      <p style="margin-block: 20px 28px;">
        The link may be outdated or the address may be incomplete. Choose a destination below to continue.
      </p>
      <div class="hero-actions" style="margin-top: 0;">
        <a href="/local-hires" class="button button-primary">Local vehicle hires</a>
        <a href="/tours" class="button button-outline">Browse journeys</a>
      </div>
    </div>
  </section>
</Layout>
