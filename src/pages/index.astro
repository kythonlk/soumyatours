---
import Layout from '../layouts/Layout.astro';
import TourCard from '../components/TourCard.astro';
import { getTours } from '../lib/api';

const tours = await getTours();
const dambadivaTours = tours.filter(t => t.country === 'India (Dambadiva)');
const sriLankaTours = tours.filter(t => t.country === 'Sri Lanka');
---

<Layout>
  <section class="bg-[#0a1d2b] text-white overflow-hidden">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-[1.02fr_.98fr] min-h-[660px]">
      <div class="px-5 sm:px-8 lg:px-12 xl:px-4 py-16 lg:py-24 flex flex-col justify-center relative z-10">
        <p class="eyebrow gold-rule">Sri Lanka · India · Nepal</p>
        <h1 class="mt-6 max-w-xl font-heading text-[2.7rem] sm:text-6xl lg:text-[4.35rem] leading-[1.04] tracking-[-.035em]">Travel with <em class="text-[#d8b978] font-heading">meaning.</em></h1>
        <p class="mt-7 max-w-lg text-base leading-7 text-slate-300">Considered journeys through Sri Lanka and the sacred Buddhist circuit—planned with warmth, local knowledge and care for every traveller.</p>
        <div class="mt-9 flex flex-wrap gap-3"><a href="#dambadiva-section" class="button-primary">Explore pilgrimages <span aria-hidden="true">→</span></a><a href="#sri-lanka-section" class="button-outline">Discover Sri Lanka</a></div>
        <dl class="mt-16 pt-7 border-t border-white/15 grid grid-cols-3 max-w-xl gap-4"><div><dt class="font-heading text-2xl text-[#d8b978]">One</dt><dd class="mt-1 text-[10px] sm:text-xs text-slate-400 uppercase tracking-[.12em] leading-4">Thoughtful point of contact</dd></div><div><dt class="font-heading text-2xl text-[#d8b978]">Local</dt><dd class="mt-1 text-[10px] sm:text-xs text-slate-400 uppercase tracking-[.12em] leading-4">Knowledge, every mile</dd></div><div><dt class="font-heading text-2xl text-[#d8b978]">Your pace</dt><dd class="mt-1 text-[10px] sm:text-xs text-slate-400 uppercase tracking-[.12em] leading-4">Made to feel personal</dd></div></dl>
      </div>
      <div class="relative min-h-[420px] lg:min-h-0 border-l border-white/10"><img src="/images/hero-banner.jpg" alt="Sigiriya and Mahabodhi Temple" class="absolute inset-0 w-full h-full object-cover object-[54%_20%] opacity-90" /><div class="absolute inset-0 bg-gradient-to-t from-[#0a1d2b]/75 via-transparent to-transparent"></div><div class="absolute bottom-0 left-0 right-0 p-6 sm:p-9 flex justify-between items-end text-white"><div><p class="eyebrow text-[#e1c58e]">A journey in two landscapes</p><p class="mt-2 font-heading text-xl">Wonder & devotion</p></div><span class="w-10 h-10 rounded-full border border-white/50 grid place-items-center text-lg">↙</span></div></div>
    </div>
  </section>

  <section class="bg-[#ede7dc] border-y border-[#d8cebc]"><div class="max-w-7xl mx-auto px-5 sm:px-8 py-5 grid sm:grid-cols-3 gap-4 text-sm text-[#334744]"><p class="flex gap-3 items-center"><span class="text-[#b88b45] text-lg">01</span> Personal itinerary planning</p><p class="flex gap-3 items-center"><span class="text-[#b88b45] text-lg">02</span> Pilgrimages & island escapes</p><p class="flex gap-3 items-center"><span class="text-[#b88b45] text-lg">03</span> Support from inquiry to return</p></div></section>

  <section id="dambadiva-section" class="py-20 sm:py-28 bg-[#f7f4ee]"><div class="max-w-7xl mx-auto px-5 sm:px-8"><div class="grid lg:grid-cols-[.75fr_1.25fr] gap-10 lg:gap-16 items-end mb-12"><div><p class="eyebrow gold-rule">Sacred journeys</p><h2 class="section-heading mt-5">Dambadiva pilgrimages</h2></div><div class="lg:pb-1"><p class="text-[#52625e] text-base leading-7 max-w-2xl">Walk the Buddhist circuit with space for reflection and the confidence of a well-considered itinerary. We take care of the practical details so the journey can remain the focus.</p><a href="/tours?category=dambadiva-pilgrimages" class="mt-5 inline-block text-xs font-bold tracking-[.12em] uppercase text-[#154d45] border-b border-[#b88b45] pb-1">View pilgrimage journeys →</a></div></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-7">{dambadivaTours.map(tour => <TourCard tour={tour} />)}</div></div></section>

  <section id="sri-lanka-section" class="bg-white py-20 sm:py-28"><div class="max-w-7xl mx-auto px-5 sm:px-8"><div class="flex flex-col md:flex-row justify-between md:items-end gap-6 mb-12 border-b border-slate-200 pb-8"><div><p class="eyebrow gold-rule">Island stories</p><h2 class="section-heading mt-5">Sri Lanka, unhurried.</h2><p class="mt-4 max-w-xl text-[#52625e] leading-7">From ancient cities to the tea country and southern coast, experience an island that rewards taking your time.</p></div><a href="/tours?category=sri-lanka-tours" class="text-xs font-bold tracking-[.12em] uppercase text-[#154d45] border-b border-[#b88b45] pb-1 whitespace-nowrap">See Sri Lanka tours →</a></div><div class="grid grid-cols-1 md:grid-cols-2 gap-7">{sriLankaTours.map(tour => <TourCard tour={tour} />)}</div></div></section>

  <section class="bg-[#154d45] text-white"><div class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-20 grid md:grid-cols-[1fr_auto] gap-10 items-center"><div><p class="eyebrow text-[#d8b978]">Begin with a conversation</p><h2 class="font-heading text-3xl sm:text-4xl mt-4">Tell us how you want to travel.</h2><p class="mt-4 text-emerald-100 max-w-xl leading-7">Whether you are planning a pilgrimage, a family holiday, or a private island journey, we will help shape the right route.</p></div><a href="/contact" class="button-primary self-start md:self-auto">Plan your journey <span aria-hidden="true">→</span></a></div></section>
</Layout>
