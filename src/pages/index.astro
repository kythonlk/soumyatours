---
import Layout from '../layouts/Layout.astro';
import TourCard from '../components/TourCard.astro';
import HirePlanner from '../components/HirePlanner.astro';
import FleetCards from '../components/FleetCards.astro';
import { getCatalog, plainText } from '../lib/catalog';

const tours = await getCatalog();
const island = tours
  .filter((t) => t.category_slug !== 'dambadiva-pilgrimages')
  .sort((a, b) => Number(b.is_featured) - Number(a.is_featured));
const pilgrimage = tours.filter((t) => t.category_slug === 'dambadiva-pilgrimages');
const featuredPilgrimage = pilgrimage[0];
const extraPilgrimages = pilgrimage.slice(1);
---
<Layout
  title="Sri Lanka Local Trips & Vehicle Hire | Saumya Tours"
  description="Plan Sri Lanka local trips, wildlife safaris, and private vehicle hires from Pita Kotte. Nissan Caravan, Mercedes-Benz AMG C-Class, local guides, and Dambadiva pilgrimages."
>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="hero-location">Pita Kotte, Sri Lanka</p>
      <h1>Sri Lanka local trips and private vehicle hire.</h1>
      <p>
        Explore Sri Lanka’s cultural triangle, hill country, and wildlife parks at your pace — or book our Nissan Caravan, Mercedes-Benz AMG C-Class, local guides, and Dambadiva pilgrimages directly from Pita Kotte.
      </p>
      <div class="hero-actions">
        <a href="#journeys" class="button button-primary">Explore local trips</a>
        <a href="#hire-planner" class="text-link text-link-on-dark">Get a hire quote</a>
      </div>
    </div>
    <div class="hero-photo">
      <img
        src="/images/sigiriya.webp"
        alt="Sigiriya rock fortress surrounded by Sri Lanka’s green forest canopy at sunset"
        width="1200"
        height="900"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section" id="journeys">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Sri Lanka trip packages and pilgrimages.</h2>
          <p>Start with our local Sri Lanka itineraries — from multi-day island circuits to Yala wildlife escapes — or plan a Dambadiva Buddhist pilgrimage across India and Nepal.</p>
        </div>
        <a href="/tours" class="text-link">View all journeys</a>
      </div>

      {island.length > 0 && (
        <div class="tour-grid">
          {island.map((tour) => (
            <TourCard tour={tour} />
          ))}
        </div>
      )}

      {featuredPilgrimage && (
        <article class="tour-spotlight tour-spotlight-below">
          <a href={`/tour/${featuredPilgrimage.slug}`} class="tour-spotlight-media" aria-label={`Explore ${featuredPilgrimage.title}`}>
            <img
              src={featuredPilgrimage.images[0].url}
              alt={featuredPilgrimage.images[0].alt_text || featuredPilgrimage.title}
              width="900"
              height="640"
              loading="lazy"
            />
            <span class="tour-destination">India &amp; Nepal</span>
          </a>
          <div class="tour-spotlight-body">
            <div class="tour-meta">
              <span>{featuredPilgrimage.duration_days} days / {Math.max(0, featuredPilgrimage.duration_days - 1)} nights</span>
              <span>Dambadiva pilgrimage</span>
            </div>
            <h3><a href={`/tour/${featuredPilgrimage.slug}`}>{featuredPilgrimage.title}</a></h3>
            <p>{plainText(featuredPilgrimage.short_description)}</p>
            <div class="tour-spotlight-actions">
              <div>
                <span class="price-label">From, per person</span>
                <strong class="tour-price">
                  {featuredPilgrimage.price > 0 ? `LKR ${featuredPilgrimage.price.toLocaleString('en-LK')}` : 'Request a quote'}
                </strong>
              </div>
              <div class="hero-actions" style="margin-top: 0;">
                <a href={`/tour/${featuredPilgrimage.slug}`} class="button button-dark">View pilgrimage</a>
                <a href="/dambadiva-tours" class="text-link">Dambadiva overview</a>
              </div>
            </div>
          </div>
        </article>
      )}

      {extraPilgrimages.length > 0 && (
        <div class="tour-grid" style="margin-top: 32px;">
          {extraPilgrimages.map((tour) => (
            <TourCard tour={tour} />
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section section-stone" id="fleet">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Two vehicles, ready to request.</h2>
          <p>One Nissan Caravan and one Mercedes-Benz AMG C-Class operating from Pita Kotte for Sri Lanka trips, airport pickups, family outings, and special occasions.</p>
        </div>
        <a href="/fleet" class="text-link">See fleet details</a>
      </div>
      <FleetCards />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <HirePlanner />
    </div>
  </section>

  <section class="section section-stone">
    <div class="container">
      <div class="section-intro">
        <h2>Practical planning, before you confirm.</h2>
        <p>Direct local support from Pita Kotte — whether you need a licensed guide, a multi-stop hire, or verified destination background.</p>
      </div>
      <div class="values-grid">
        <div class="value">
          <h3>Local &amp; pilgrimage guides</h3>
          <p>Arrange Sri Lanka sightseeing commentary or discuss Dambadiva tour leadership around your group’s language and walking pace.</p>
          <a href="/guides" class="text-link">Explore guide options</a>
        </div>
        <div class="value">
          <h3>12 sourced travel guides</h3>
          <p>Checklists and official links covering Bandaranaike Airport transfers, Sigiriya, Kandy, Ella rail bookings, Yala, and Dambadiva.</p>
          <a href="/news" class="text-link">Read travel guides</a>
        </div>
        <div class="value">
          <h3>How Saumya Tours works</h3>
          <p>Every request starts with a direct conversation and a written quote covering vehicle, stops, inclusions, and terms before you decide.</p>
          <a href="/about" class="text-link">About our team</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
