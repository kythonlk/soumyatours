---
import Layout from '../layouts/Layout.astro';
import TourCard from '../components/TourCard.astro';
import { getTours } from '../lib/api';

const tours = await getTours();
const dambadivaTours = tours.filter(t => t.country === 'India (Dambadiva)');
const sriLankaTours = tours.filter(t => t.country === 'Sri Lanka');
---

<Layout>
  <!-- Majestic Travel Hero Section -->
  <section class="relative bg-[#022c22] text-white min-h-[620px] lg:min-h-[680px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/hero-banner.jpg" 
        alt="Saumya Tours Sri Lanka and India Dambadiva" 
        class="w-full h-full object-cover object-center filter brightness-90"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#022c22]/95 via-[#022c22]/70 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#022c22] via-transparent to-transparent"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-2xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-900/80 border border-emerald-500/40 text-amber-300 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          2026 PILGRIMAGE & HOLIDAY RESERVATIONS OPEN
        </div>

        <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight">
          Journeys of Wonder, <br />
          <span class="gold-travel-text">Pilgrimages of Faith</span>
        </h1>

        <p class="text-sm sm:text-base text-emerald-100/90 leading-relaxed font-light max-w-xl">
          Experience Sri Lanka’s magical ancient kingdoms, hill country tea estates, and wild leopard safaris — and embark on sacred, life-enriching <strong>India Dambadiva Buddhist Pilgrimages</strong> directly from Colombo with venerated Sinhala monk guidance.
        </p>

        <div class="pt-4 flex flex-wrap gap-4">
          <a 
            href="#dambadiva-section" 
            class="px-8 py-3.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-xs sm:text-sm uppercase tracking-wider rounded-xl shadow-xl transition-all hover:scale-102 flex items-center gap-2"
          >
            <span>☸️</span> India Dambadiva Tours
          </a>
          <a 
            href="#sri-lanka-section" 
            class="px-8 py-3.5 bg-emerald-950/80 hover:bg-emerald-900 text-amber-300 border border-emerald-500/40 font-bold text-xs sm:text-sm uppercase tracking-wider rounded-xl backdrop-blur-xs transition-all hover:scale-102"
          >
            Sri Lanka Inbound Tours
          </a>
        </div>

        <!-- Pillar Stats -->
        <div class="pt-8 border-t border-emerald-800/80 grid grid-cols-3 gap-4 text-xs text-emerald-200">
          <div>
            <div class="text-white font-bold text-base font-heading">15+ Years</div>
            <div class="text-[11px] text-amber-300">Pilgrimage Leadership</div>
          </div>
          <div>
            <div class="text-white font-bold text-base font-heading">12,000+</div>
            <div class="text-[11px] text-amber-300">Blessed Pilgrims Guided</div>
          </div>
          <div>
            <div class="text-white font-bold text-base font-heading">100% Full Board</div>
            <div class="text-[11px] text-amber-300">Colombo Direct Flights</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- India Dambadiva Highlight Hub -->
  <section id="dambadiva-section" class="py-16 bg-[#042f2e] text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.25em] text-amber-400 font-mono">// SACRED PILGRIMAGES FROM SRI LANKA</span>
          <h2 class="font-heading text-3xl sm:text-4xl font-bold mt-1 text-white">India Dambadiva Sacred Circuit</h2>
          <p class="text-xs sm:text-sm text-emerald-200/80 mt-2 max-w-2xl font-light">
            Worship at Bodh Gaya, Sarnath, Kushinagar, Rajgir, Nalanda, and Lumbini. Complete peace of mind with Sinhala-speaking Buddhist monks, Colombo return airfare, and 4-star AC hotel stays.
          </p>
        </div>
        <a href="/tours?category=dambadiva-pilgrimages" class="text-xs font-bold uppercase tracking-wider text-amber-400 hover:underline">
          View All Dambadiva Dates →
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {dambadivaTours.map(tour => (
          <TourCard tour={tour} />
        ))}
      </div>

      <!-- Dambadiva Pilgrimage Inclusions Strip -->
      <div class="mt-12 p-6 rounded-2xl bg-[#022c22] border border-emerald-700/60 grid grid-cols-1 md:grid-cols-4 gap-6 text-xs text-emerald-100">
        <div class="space-y-1">
          <div class="text-amber-300 font-bold text-sm">✈️ Direct Flights</div>
          <p>SriLankan Airlines return flights CMB - GAYA with luggage included.</p>
        </div>
        <div class="space-y-1">
          <div class="text-amber-300 font-bold text-sm">🍲 3 Daily Sri Lankan Meals</div>
          <p>Freshly cooked traditional Sri Lankan buffet prepared by our accompanying chefs.</p>
        </div>
        <div class="space-y-1">
          <div class="text-amber-300 font-bold text-sm">☸️ Venerable Sinhala Monks</div>
          <p>Deep spiritual commentary, daily Dhamma discussions, and Bodhi Pooja ceremonies.</p>
        </div>
        <div class="space-y-1">
          <div class="text-amber-300 font-bold text-sm">🚌 Luxury AC Coaches</div>
          <p>Comfortable Mercedes-Benz tourist coaches with cold water & fruit service.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sri Lanka Guided Tours Section -->
  <section id="sri-lanka-section" class="py-16 bg-[#f8fafc]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.25em] text-emerald-800 font-mono">// INBOUND EXPERIENCES</span>
          <h2 class="font-heading text-3xl font-bold text-slate-900 mt-1">Explore Sri Lanka</h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 max-w-2xl font-light">
            From the monumental rock palace of Sigiriya to the misty tea country of Ella and leopard safaris in Yala.
          </p>
        </div>
        <a href="/tours?category=sri-lanka-tours" class="text-xs font-bold uppercase tracking-wider text-emerald-800 hover:underline">
          Browse All Sri Lanka Tours →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sriLankaTours.map(tour => (
          <TourCard tour={tour} />
        ))}
      </div>
    </div>
  </section>

  <!-- Traveler Testimonials -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-[0.25em] text-amber-700 font-mono">// PILGRIM & TRAVELER REVIEWS</span>
        <h2 class="font-heading text-3xl font-bold text-slate-900 mt-2">Blessed Journeys & Memories</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
        <div class="p-6 bg-[#f8fafc] rounded-2xl border border-slate-200 space-y-3">
          <div class="text-amber-500 text-sm">★★★★★</div>
          <p class="text-slate-600 italic leading-relaxed">
            "My mother (74 years) and I joined the 12-Day Dambadiva pilgrimage. Saumya Tours took wonderful care of our elders. The Sinhala food was delicious, and worshiping under the Bodhi Tree at Bodh Gaya was life-changing."
          </p>
          <div class="pt-2 border-t border-slate-200 font-semibold text-slate-800 flex justify-between">
            <span>Karunaratne Alwis</span>
            <span class="text-slate-400 font-normal">Nugegoda, Colombo</span>
          </div>
        </div>

        <div class="p-6 bg-[#f8fafc] rounded-2xl border border-slate-200 space-y-3">
          <div class="text-amber-500 text-sm">★★★★★</div>
          <p class="text-slate-600 italic leading-relaxed">
            "We did the 7-day Sri Lanka highlights tour. The private van was spotless, and our chauffeur guide knew every hidden viewpoint in Sigiriya and Ella. Outstanding service!"
          </p>
          <div class="pt-2 border-t border-slate-200 font-semibold text-slate-800 flex justify-between">
            <span>David & Claire Miller</span>
            <span class="text-slate-400 font-normal">Melbourne, Australia</span>
          </div>
        </div>

        <div class="p-6 bg-[#f8fafc] rounded-2xl border border-slate-200 space-y-3">
          <div class="text-amber-500 text-sm">★★★★★</div>
          <p class="text-slate-600 italic leading-relaxed">
            "The Yala safari was breathtaking! We spotted 2 leopards and a herd of elephants within two hours. Saumya Tours arranged the top tracker in the park."
          </p>
          <div class="pt-2 border-t border-slate-200 font-semibold text-slate-800 flex justify-between">
            <span>Nalaka Ranasinghe</span>
            <span class="text-slate-400 font-normal">Kandy</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
