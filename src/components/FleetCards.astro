---
import { fleet } from '../lib/fleet';
---
<div class="fleet-grid">
  {fleet.map((vehicle) => (
    <article class="fleet-card">
      <div class="fleet-media">
        <img
          src={vehicle.image}
          alt={vehicle.imageAlt}
          width="1200"
          height="805"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="fleet-copy">
        <p class="fleet-type">
          {vehicle.type}
          <span>1 vehicle in fleet</span>
        </p>
        <h3>{vehicle.name}</h3>
        <p>{vehicle.description}</p>
        <div class="fleet-features">
          <span>{vehicle.use}</span>
          <span>Written route quote</span>
        </div>
        <a href={`/local-hires?vehicle=${vehicle.id}#hire-planner`} class="button button-primary">
          Request this vehicle
        </a>
      </div>
    </article>
  ))}
</div>
