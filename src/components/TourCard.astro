---
import type { TourPackage } from '../lib/api';

interface Props {
  tour: TourPackage;
}

const { tour } = Astro.props;
const primaryImage = tour.images?.[0]?.url || '/images/dambadiva.jpg';
const discount = tour.compare_at_price && tour.compare_at_price > tour.price
  ? tour.compare_at_price - tour.price
  : 0;
---

<div class="group bg-white rounded-2xl border border-emerald-100 hover:border-emerald-500/60 transition-all duration-300 flex flex-col overflow-hidden shadow-sm hover:shadow-xl">
  <!-- Image Frame -->
  <div class="relative aspect-16/10 overflow-hidden bg-slate-100">
    <a href={`/tour/${tour.slug}`} class="block w-full h-full">
      <img 
        src={primaryImage} 
        alt={tour.title} 
        class="w-full h-full object-cover object-center group-hover:scale-108 transition-transform duration-700 ease-out" 
        loading="lazy"
      />
    </a>

    <!-- Top Badges -->
    <div class="absolute top-3 left-3 flex flex-col gap-1.5">
      <span class="bg-[#022c22]/90 text-amber-300 text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider backdrop-blur-xs border border-emerald-700">
        {tour.country === 'India (Dambadiva)' ? '☸️ India Dambadiva' : '🇱🇰 Sri Lanka Tour'}
      </span>
      {discount > 0 && (
        <span class="bg-amber-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">
          Save Rs. {discount.toLocaleString()}
        </span>
      )}
    </div>

    <!-- Duration Pill -->
    <div class="absolute bottom-3 right-3 bg-black/75 backdrop-blur-xs text-white text-xs font-semibold px-3 py-1 rounded-full">
      ⏱ {tour.duration_days} Days / {tour.duration_days - 1} Nights
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
    <div>
      <div class="flex items-center justify-between text-xs text-emerald-800 font-semibold mb-1">
        <span>{tour.category_name || 'Guided Tour'}</span>
        <div class="flex items-center text-amber-500 font-bold">
          <span>★</span>
          <span class="ml-1 text-slate-700">{tour.avg_rating || 5.0}</span>
          <span class="text-slate-400 font-normal ml-0.5">({tour.review_count || 45})</span>
        </div>
      </div>

      <a href={`/tour/${tour.slug}`} class="block">
        <h3 class="font-heading text-lg font-bold text-slate-900 group-hover:text-emerald-800 transition-colors line-clamp-2">
          {tour.title}
        </h3>
      </a>

      <p class="text-xs text-slate-600 mt-2 line-clamp-2 leading-relaxed">
        {tour.short_description}
      </p>

      <!-- Key Inclusions Preview -->
      <div class="mt-3 pt-3 border-t border-slate-100 space-y-1">
        <div class="text-[11px] text-emerald-800 font-medium flex items-center gap-1.5">
          <span>✓</span> All Meals & 4-Star AC Accommodation Included
        </div>
        <div class="text-[11px] text-emerald-800 font-medium flex items-center gap-1.5">
          <span>✓</span> Official Tourist Guide / Sinhala Speaking Monks
        </div>
      </div>
    </div>

    <!-- Pricing & CTAs -->
    <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
      <div>
        <div class="text-[10px] text-slate-500 uppercase tracking-wider">All-Inclusive From</div>
        <div class="text-lg font-bold text-emerald-950 font-heading">
          Rs. {tour.price.toLocaleString()}
        </div>
        {tour.compare_at_price && (
          <div class="text-xs text-slate-400 line-through">
            Rs. {tour.compare_at_price.toLocaleString()}
          </div>
        )}
      </div>

      <div class="flex items-center gap-2">
        <a 
          href={`/tour/${tour.slug}`} 
          class="px-3.5 py-2 border border-emerald-700 text-emerald-800 hover:bg-emerald-50 rounded-lg text-xs font-bold transition-colors"
        >
          Itinerary
        </a>
        <button 
          onclick={`window.openBookingModal('${tour.title.replace(/'/g, "\\'")}')`}
          class="px-3.5 py-2 bg-emerald-800 hover:bg-emerald-700 text-amber-200 rounded-lg text-xs font-bold transition-colors shadow-xs"
        >
          Book
        </button>
      </div>
    </div>
  </div>
</div>
