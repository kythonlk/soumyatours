---
import type { TourPackage } from '../lib/api';

interface Props {
  tour: TourPackage;
}

const { tour } = Astro.props;
const primaryImage = tour.images?.[0]?.url || '/images/dambadiva.jpg';
const discount = tour.compare_at_price && tour.compare_at_price > tour.price
  ? tour.compare_at_price - tour.price
  : 0;
---

<article class="group bg-white border border-[#ddd5c7] transition-all duration-300 flex flex-col overflow-hidden hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(10,29,43,.12)]">
  <!-- Image Frame -->
  <div class="relative aspect-[16/9] overflow-hidden bg-slate-100">
    <a href={`/tour/${tour.slug}`} class="block w-full h-full">
      <img 
        src={primaryImage} 
        alt={tour.title} 
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
        loading="lazy"
      />
    </a>

    <div class="absolute inset-0 bg-gradient-to-t from-[#0a1d2b]/45 via-transparent to-transparent pointer-events-none"></div>
    <div class="absolute top-4 left-4 flex flex-col gap-1.5">
      <span class="bg-[#0a1d2b]/90 text-[#e2c384] text-[10px] font-bold px-3 py-1.5 uppercase tracking-[.12em] backdrop-blur-sm">
        {tour.country === 'India (Dambadiva)' ? 'Dambadiva' : 'Sri Lanka'}
      </span>
      {discount > 0 && (
        <span class="bg-[#b88b45] text-white text-[10px] font-bold px-2 py-1 uppercase tracking-wider">
          Save Rs. {discount.toLocaleString()}
        </span>
      )}
    </div>

    <div class="absolute bottom-4 left-4 text-white text-xs font-semibold tracking-wide">
      {tour.duration_days} days · {tour.duration_days - 1} nights
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-5">
    <div>
      <div class="flex items-center justify-between text-[11px] uppercase tracking-[.1em] text-[#587069] font-semibold mb-3">
        <span>{tour.category_name || 'Guided Tour'}</span>
        <div class="flex items-center text-[#b88b45] font-bold tracking-normal">
          <span>★</span>
          <span class="ml-1 text-slate-700">{tour.avg_rating || 5.0}</span>
          <span class="text-slate-400 font-normal ml-0.5">({tour.review_count || 45})</span>
        </div>
      </div>

      <a href={`/tour/${tour.slug}`} class="block">
        <h3 class="font-heading text-xl font-bold text-[#0a1d2b] group-hover:text-[#154d45] transition-colors line-clamp-2 leading-snug">
          {tour.title}
        </h3>
      </a>

      <p class="text-sm text-slate-600 mt-3 line-clamp-2 leading-relaxed">
        {tour.short_description}
      </p>

      <div class="mt-5 pt-4 border-t border-[#e8e2d8] space-y-1.5">
        <div class="text-[11px] text-[#365d55] font-medium flex items-center gap-2"><span class="text-[#b88b45]">—</span> Carefully arranged accommodation & transport</div>
        <div class="text-[11px] text-[#365d55] font-medium flex items-center gap-2"><span class="text-[#b88b45]">—</span> Guidance throughout your journey</div>
      </div>
    </div>

    <!-- Pricing & CTAs -->
    <div class="pt-5 border-t border-[#e8e2d8] flex items-end justify-between gap-4">
      <div>
        <div class="text-[10px] text-slate-500 uppercase tracking-[.12em]">From</div>
        <div class="text-xl font-bold text-[#0a1d2b] font-heading">
          Rs. {tour.price.toLocaleString()}
        </div>
        {tour.compare_at_price && (
          <div class="text-xs text-slate-400 line-through">
            Rs. {tour.compare_at_price.toLocaleString()}
          </div>
        )}
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <a 
          href={`/tour/${tour.slug}`} 
          class="px-3.5 py-2 border border-[#154d45] text-[#154d45] hover:bg-[#edf3f0] text-xs font-bold transition-colors"
        >
          Itinerary
        </a>
        <button 
          onclick={`window.openBookingModal('${tour.title.replace(/'/g, "\\'")}')`}
          class="px-3.5 py-2 bg-[#154d45] hover:bg-[#0f4039] text-white text-xs font-bold transition-colors"
        >
          Book
        </button>
      </div>
    </div>
  </div>
</article>
